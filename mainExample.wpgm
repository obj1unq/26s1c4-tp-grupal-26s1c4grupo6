import wollok.game.*
import forest.*
import comidas.*
import colisiones.*
import spawner.*

program PepitaGame {
	game.title("Forest Run")
	game.height(9)
	game.width(16)
	game.cellSize(50)
	game.addVisual(forest)
	game.addVisual(manzana)
	juego.movimientos()
	forest.correr()
	spawner.iniciar()
    game.boardGround("fondo-nivel-1.gif")
	game.start()
	game.onCollideDo(forest, {objeto => objeto.choqueCon(forest)})
}
